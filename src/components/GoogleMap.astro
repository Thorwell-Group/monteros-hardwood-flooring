---
// Click-to-load map. The Google Maps embed pulls ~400 KB of script, which was
// slowing every city page; now it only loads when someone asks for it.
interface Props { query: string; title: string; height?: string; }
const { query, title, height = 'h-[400px]' } = Astro.props as Props;
const url = `https://www.google.com/maps?q=${encodeURIComponent(query)}&output=embed`;
const link = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
---
<div class={`map-facade relative w-full ${height} rounded-2xl overflow-hidden border border-slate-200 bg-brand-950`} data-src={url} data-title={title}>
  <div class="absolute inset-0 opacity-25 bg-[linear-gradient(rgba(214,180,126,.35)_1px,transparent_1px),linear-gradient(90deg,rgba(214,180,126,.35)_1px,transparent_1px)] bg-[size:28px_28px]" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-gradient-to-br from-brand-900/40 to-brand-950/90" aria-hidden="true"></div>
  <div class="relative h-full flex flex-col items-center justify-center text-center px-6 text-white">
    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-wood-400 text-brand-950 shadow-lg drift">
      <svg class="h-7 w-7" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
    </span>
    <div class="mt-4 font-display text-xl font-bold">{query}</div>
    <p class="mt-1 text-sm text-brand-100/80">Inside our Inland Empire service area</p>
    <div class="mt-5 flex flex-wrap justify-center gap-2">
      <button type="button" class="map-load btn-cta px-5 py-2.5">Show map</button>
      <a href={link} target="_blank" rel="noopener" class="btn-outline px-5 py-2.5 border-white/50">Open in Google Maps</a>
    </div>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('.map-facade').forEach((box) => {
    box.querySelector('.map-load')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = box.dataset.src!; f.title = box.dataset.title!;
      f.width = '100%'; f.height = '100%'; f.style.border = '0';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      box.replaceChildren(f);
    });
  });
</script>
