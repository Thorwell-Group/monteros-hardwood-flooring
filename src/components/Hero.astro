---
import { business } from '~/data/business';
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image: string;
  alt: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
  ratingBadge?: boolean;
  // Homepage only: real job photos fanned on the right of the hero.
  stack?: { src: string; alt: string }[];
}
const {
  eyebrow,
  title,
  subtitle,
  image,
  alt,
  primaryCta = { href: '/free-estimate/', label: 'Get a Free Estimate' },
  secondaryCta = { href: `tel:${business.phoneE164}`, label: `Call ${business.phoneDisplay}` },
  ratingBadge = true,
  stack,
} = Astro.props as Props;
const words = title.split(' ');
---
<section class="relative overflow-hidden bg-brand-950 text-white">
  <div class="absolute inset-0 z-0">
    <img src={image} alt={alt} class="hero-kenburns h-full w-full object-cover" loading="eager" decoding="async" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-r from-brand-950/95 via-brand-950/75 to-brand-950/25"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-brand-950/70 to-transparent"></div>
  </div>
  <div class="relative z-10 container-wide py-20 md:py-28 lg:py-32">
    <div class:list={['grid items-center gap-12', stack && 'lg:grid-cols-[1.1fr_0.9fr]']}>
      <div class="max-w-2xl">
        {eyebrow && (
          <div class="inline-flex items-center gap-2 rounded-full border border-wood-300/40 bg-wood-500/15 px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.2em] text-wood-200 mb-6" data-reveal>
            <span class="h-1.5 w-1.5 rounded-full bg-wood-300"></span>{eyebrow}
          </div>
        )}
        <h1 class="text-white text-balance leading-[1.05]">
          {words.map((w, i) => (<><span class="rise" style={`animation-delay:${0.15 + i * 0.06}s`}>{w}</span>{' '}</>))}
        </h1>
        {subtitle && <p class="mt-6 text-lg md:text-xl text-slate-200/90 leading-relaxed text-balance" data-reveal data-reveal-delay="200">{subtitle}</p>}
        <div class="mt-9 flex flex-wrap gap-3" data-reveal data-reveal-delay="300">
          <a href={primaryCta.href} class="btn-cta text-base px-7 py-4">{primaryCta.label}
            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 10h10m0 0l-4-4m4 4l-4 4"/></svg>
          </a>
          <a href={secondaryCta.href} class="btn-outline text-base px-7 py-4 border-white/50">{secondaryCta.label}</a>
        </div>
        {ratingBadge && (
          <a href={business.social.googleSearch} target="_blank" rel="noopener" class="mt-9 inline-flex items-center gap-3 rounded-full glass px-4 py-2 text-sm text-white hover:text-white" data-reveal data-reveal-delay="400">
            <span class="flex items-center gap-0.5 text-amber-400">
              {[1,2,3,4,5].map(() => (<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor"><path d="M10 1l2.928 6.063L19.5 8 14.75 12.625 16 19l-6-3.5L4 19l1.25-6.375L.5 8l6.572-.937L10 1z"/></svg>))}
            </span>
            <span><strong>{business.ratings.averageRating}</strong> from {business.ratings.reviewCount} Google reviews</span>
          </a>
        )}
      </div>

      {stack && stack.length >= 3 && (
        <div class="relative hidden lg:block h-[460px]" aria-label="Recent Monteros projects">
          <div class="absolute left-0 top-12 w-[44%]" data-reveal="left" data-reveal-delay="300">
            <figure class="aspect-[3/4] rounded-2xl overflow-hidden shadow-2xl ring-4 ring-white/90 -rotate-6 transition-transform duration-500 hover:-rotate-2 hover:scale-105">
              <img src={stack[1].src} alt={stack[1].alt} class="h-full w-full object-cover" loading="eager" decoding="async" />
            </figure>
          </div>
          <div class="absolute right-0 top-16 w-[44%]" data-reveal="right" data-reveal-delay="400">
            <figure class="aspect-[3/4] rounded-2xl overflow-hidden shadow-2xl ring-4 ring-white/90 rotate-6 transition-transform duration-500 hover:rotate-2 hover:scale-105">
              <img src={stack[2].src} alt={stack[2].alt} class="h-full w-full object-cover" loading="eager" decoding="async" />
            </figure>
          </div>
          <div class="absolute left-[24%] top-0 w-[52%] z-10" data-reveal="zoom" data-reveal-delay="200">
            <figure class="relative aspect-[3/4] rounded-2xl overflow-hidden shadow-2xl ring-4 ring-white transition-transform duration-500 hover:scale-[1.03]">
              <img src={stack[0].src} alt={stack[0].alt} class="h-full w-full object-cover" loading="eager" decoding="async" />
              <figcaption class="absolute inset-x-3 bottom-3 rounded-xl bg-white/95 px-3 py-2 text-xs font-semibold text-brand-900 shadow">
                <span class="text-wood-600">Real Monteros job</span> · Inland Empire
              </figcaption>
            </figure>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
