---
import { business } from '~/data/business';
// Numbers render at their final value in the HTML; the counter script in
// BaseLayout only animates them up when JS runs, so nothing ever shows "0".
const stats = [
  { value: String(business.yearsInBusiness), suffix: '+', counter: true, label: 'Years family-owned' },
  { value: String(business.ratings.averageRating), suffix: '★', counter: true, label: `${business.ratings.reviewCount} Google reviews` },
  { value: 'Lifetime', label: 'Workmanship guarantee' },
  { value: 'Free', label: 'In-home estimate' },
];
---
<section class="relative bg-brand-950 text-white overflow-hidden">
  <div class="absolute inset-0 opacity-[0.07] bg-[repeating-linear-gradient(90deg,#d6b47e_0_1px,transparent_1px_140px)]" aria-hidden="true"></div>
  <div class="relative container-wide py-10 md:py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-y-8 md:divide-x md:divide-white/10 text-center">
      {stats.map((s, i) => (
        <div class="px-4" data-reveal data-reveal-delay={String((i + 1) * 100)}>
          <div class="font-display text-3xl md:text-[2.75rem] font-extrabold leading-none text-white">
            {s.counter
              ? <span data-counter={s.value} data-counter-suffix={s.suffix === '+' ? '+' : ''}>{s.value}{s.suffix === '+' ? '+' : ''}</span>
              : s.value}
            {s.suffix === '★' && <span class="text-amber-400 ml-1">★</span>}
          </div>
          <div class="mt-3 text-[11px] uppercase tracking-[0.2em] text-wood-200/80 font-semibold">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>
