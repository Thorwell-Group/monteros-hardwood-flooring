---
/**
 * /es/free-estimate — Spanish mirror of /free-estimate/ (paid-traffic funnel).
 * Same TFPros /book funnel layout and the same claims as the English page — only
 * what the main site states. No discounts. Keep the two in sync.
 */
import LandingLayout from '~/layouts/LandingLayout.astro';
import { business } from '~/data/business';

// Spanish translations of the verified reviews in src/data/testimonials.ts
// (same authors, same order — translate any new ones from that file).
const reviews = [
  {
    text: `Fácil trabajar con ellos, puntuales y al precio justo cotizado. Javier respetó una cotización anterior y entregó resultados increíbles. Muy recomendados.`,
    author: 'David Thurston',
    city: 'Inland Empire',
    rating: 5,
  },
  {
    text: `¡Equipo increíble! Trabajan juntos como una máquina — amables, atentos, detallistas y muy productivos. Llegaron a tiempo e hicieron un trabajo de maestros. Solo usaría a ellos para proyectos futuros.`,
    author: 'Bob Entrikin',
    city: 'Inland Empire',
    rating: 5,
  },
  {
    text: `Monteros Hardwood acaba de renovar 3 habitaciones de mi casa e hicieron un trabajo fantástico. Llegaron a tiempo y fueron muy profesionales. Los volvería a contratar y los recomendaría a mi familia y amigos. ¡Buen trabajo!`,
    author: 'Sybille Norsian',
    city: 'Inland Empire',
    rating: 5,
  },
  {
    text: `Sin duda LA MEJOR compañía. Excelentes instaladores, muy buena comunicación y profesionales en todo. ¡Muy recomendados!`,
    author: 'Debi Sintov',
    city: 'Inland Empire',
    rating: 5,
  },
  {
    text: `¡El mejor precio de la ciudad! Así de simple. Un gran grupo de muchachos. Javier y su equipo hicieron un gran trabajo en mis pisos. Jóvenes y con ganas de terminar el trabajo. Los recomiendo mucho, llámenlos.`,
    author: 'Javi Nicanor',
    city: 'Inland Empire',
    rating: 5,
  },
  {
    text: `Ricardo hizo un trabajo excelente al reemplazar el piso de nuestra cocina.`,
    author: 'Norma Hinderliter',
    city: 'Inland Empire',
    rating: 5,
    service: 'Pisos de Cocina',
  },
];

const TZ = 'America/Los_Angeles';
const { averageRating, reviewCount } = business.ratings;

const strip = [
  `Empresa familiar por más de ${business.yearsInBusiness} años`,
  `${averageRating}★ en Google`,
  'Estimaciones gratuitas en casa · muestras en sitio',
  'Garantía de mano de obra de por vida',
  'Con licencia y seguro en California',
  'Servimos todo el Inland Empire',
];

const faqs = [
  { q: '¿La estimación es gratuita?', a: 'Sí. Cada estimación es gratuita y sin presión, con muestras en sitio. Medimos, tomamos lecturas de humedad del contrapiso, revisamos especies y acabados con usted, y le damos una cotización detallada por escrito.' },
  { q: '¿Qué áreas cubren?', a: 'Todo el Inland Empire — San Bernardino, Fontana, Rancho Cucamonga, Ontario, Riverside, Corona, Rialto, Redlands, Highland y Loma Linda — además de proyectos más grandes en Orange County y Palm Springs con cita.' },
  { q: '¿Tienen licencia y seguro?', a: 'Sí. Licencia completa en California y seguro de responsabilidad general y de compensación para trabajadores.' },
  { q: '¿Qué garantía ofrecen?', a: 'Garantía de mano de obra de por vida en cada instalación — si nuestra instalación llega a fallar, la reparamos. La garantía de los materiales varía según el producto.' },
];
---
<LandingLayout
  title="Estimación Gratuita de Pisos en Casa | Monteros Hardwood Flooring"
  description="Cuéntenos sobre su proyecto de pisos de madera. Estimación gratuita y sin presión en casa en todo el Inland Empire. Empresa familiar, con licencia y seguro."
  pathname="/es/free-estimate/"
  lang="es"
>
  {/* FRANJA — hechos reales del sitio, nada más */}
  <div class="fe-strip bg-wood-500 text-white overflow-hidden" aria-label="Por qué Monteros">
    <div class="fe-strip-track flex whitespace-nowrap py-2 text-[0.8rem] font-semibold tracking-wide">
      {Array.from({ length: 2 }).map(() => (
        <div class="flex shrink-0 items-center">
          {strip.map((msg) => (
            <span class="flex items-center px-5">
              <span>{msg}</span>
              <span class="ml-10 text-white/50" aria-hidden="true">·</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  {/* HERO — titular + subtítulo, luego el formulario (visible al cargar) */}
  <section class="bg-brand-900 text-white">
    <div class="mx-auto w-full max-w-6xl px-5 pt-4 pb-12 lg:pt-14 lg:pb-20">
      <div class="grid lg:grid-cols-[1fr_480px] gap-5 lg:gap-14 items-start">
        <div class="lg:pt-6">
          <h1 class="font-display font-extrabold tracking-tight leading-[1.1] text-[1.5rem] sm:text-4xl lg:text-5xl text-white">
            Nos encantaría hablar con usted sobre <span class="text-wood-300">su proyecto.</span>
          </h1>
          <p class="mt-2 lg:mt-5 text-[0.95rem] sm:text-lg text-white/80 leading-snug lg:leading-relaxed max-w-xl">
            Envíe su información y alguien se comunicará con usted sobre su proyecto y su visión.
          </p>
          <ul class="hidden lg:grid mt-7 gap-2.5 list-none p-0">
            {[
              'Estimación gratuita en casa, sin presión',
              'Llevamos muestras a su hogar',
              'Cotización detallada por escrito',
              'Garantía de mano de obra de por vida',
            ].map((v) => (
              <li class="flex items-center gap-2.5 text-base text-white/90">
                <svg class="w-5 h-5 flex-none text-wood-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>{v}</span>
              </li>
            ))}
          </ul>
        </div>

        <div id="form" class="scroll-mt-4">
          <div class="rounded-2xl bg-white ring-1 ring-wood-400/40 shadow-xl overflow-hidden">
            <div class="bg-gradient-to-r from-wood-500 to-wood-700 px-5 py-2.5">
              <div class="text-[0.65rem] uppercase tracking-[0.2em] font-bold text-white/85">Gratis · Sin compromiso</div>
              <div class="font-display text-lg font-bold text-white leading-tight">Cuéntenos sobre su proyecto</div>
            </div>
            <iframe
              src="https://api.leadconnectorhq.com/widget/survey/bGjke5DT10ATM54G1Cdr"
              style="border:none;width:100%;height:560px;display:block;background:transparent;"
              scrolling="no"
              id="bGjke5DT10ATM54G1Cdr"
              title="Solicitud de estimación gratuita"
              loading="eager"
              fetchpriority="high"
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* CITAS DE LA SEMANA — se reinicia cada domingo a medianoche, hora del Pacífico */}
  <section class="bg-gradient-to-r from-brand-950 via-brand-800 to-brand-950 text-white border-y border-wood-400/30">
    <div class="mx-auto max-w-6xl px-5 py-10 lg:py-14 flex flex-col lg:flex-row items-center justify-between gap-7">
      <div class="text-center lg:text-left">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 ring-1 ring-white/20 px-3 py-1 text-[0.65rem] uppercase tracking-[0.2em] font-bold">
          <span class="h-1.5 w-1.5 rounded-full bg-wood-300 animate-pulse"></span>
          Cupos limitados
        </span>
        <h2 class="mt-3 font-display text-3xl sm:text-4xl font-extrabold leading-tight text-white">Citas disponibles esta semana</h2>
        <p class="mt-2 text-white/75">La agenda de esta semana se cierra cuando el contador llegue a cero.</p>
      </div>
      <div class="flex gap-2.5 sm:gap-3" data-countdown data-tz={TZ} role="timer" aria-label="Tiempo restante para reservar esta semana">
        {[['d', 'Días'], ['h', 'Hrs'], ['m', 'Min'], ['s', 'Seg']].map(([k, label]) => (
          <div class="cd-seg">
            <span data-cd={k}>--</span>
            <small>{label}</small>
          </div>
        ))}
      </div>
    </div>
    <div class="pb-10 text-center">
      <a href="#form" class="inline-flex items-center gap-2 rounded-full bg-wood-500 hover:bg-wood-600 px-7 py-3.5 font-bold text-sm text-white">
        Aparte su cita esta semana
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  {/* RESEÑAS — reseñas reales de Google (traducidas) */}
  <section class="bg-white py-14 lg:py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="text-center max-w-2xl mx-auto">
        <div class="text-amber-400 tracking-[0.2em] text-lg" aria-hidden="true">★★★★★</div>
        <h2 class="mt-2 font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight text-brand-900">Lo que dicen nuestros clientes del Inland Empire.</h2>
        <p class="mt-2 text-sm text-slate-500">Reseñas reales de Google · {averageRating}★ en {reviewCount} reseñas</p>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 list-none p-0">
        {reviews.map((t) => (
          <li class="rounded-2xl bg-brand-50 ring-1 ring-brand-100 p-6">
            <div class="flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-700 text-white font-bold text-sm" aria-hidden="true">{t.author.charAt(0)}</span>
              <div class="leading-tight">
                <div class="font-semibold text-sm text-brand-900">{t.author}</div>
                <div class="text-[11px] text-slate-500">{t.city}{t.service ? ` · ${t.service}` : ''}</div>
              </div>
              <div class="ml-auto text-amber-400 tracking-[2px] text-sm" aria-label={`${t.rating} de 5 estrellas`}>{'★'.repeat(t.rating)}</div>
            </div>
            <p class="mt-4 text-sm text-slate-700 leading-relaxed">"{t.text}"</p>
          </li>
        ))}
      </ul>
      <div class="mt-8 text-center">
        <a href="#form" class="inline-flex items-center gap-2 rounded-full bg-brand-700 hover:bg-brand-800 px-6 py-3 font-semibold text-white text-sm">Cuéntenos sobre su proyecto</a>
      </div>
    </div>
  </section>

  {/* DATOS — solo lo que dice el sitio principal */}
  <section class="bg-brand-900 text-white py-12 lg:py-16">
    <ul class="mx-auto max-w-6xl px-5 grid grid-cols-2 lg:grid-cols-4 gap-y-8 gap-x-6 text-center list-none p-0">
      {[
        { v: `${business.yearsInBusiness}+`, label: 'Años como empresa familiar' },
        { v: `${averageRating}★`, label: 'En Google' },
        { v: 'De por vida', label: 'Garantía de mano de obra' },
        { v: 'Licencia', label: 'Y seguro en California' },
      ].map((s) => (
        <li>
          <div class="font-display text-4xl sm:text-5xl font-extrabold text-wood-300 leading-none">{s.v}</div>
          <div class="mt-3 text-[11px] uppercase tracking-[0.22em] text-brand-200 font-semibold">{s.label}</div>
        </li>
      ))}
    </ul>
  </section>

  {/* QUÉ SIGUE */}
  <section class="bg-brand-50 py-14 lg:py-20">
    <div class="mx-auto max-w-5xl px-5">
      <h2 class="text-center font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight text-brand-900">Qué sigue.</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-3 list-none p-0">
        {[
          { n: '01', t: 'Nos comunicamos con usted', b: 'Alguien de nuestro equipo se comunica con usted para hablar sobre su proyecto y su visión.' },
          { n: '02', t: 'Estimación gratuita en casa', b: 'Llevamos muestras, medimos, tomamos lecturas de humedad del contrapiso y revisamos especies y acabados con usted. Sin presión.' },
          { n: '03', t: 'Cotización por escrito', b: 'Una cotización detallada por escrito, con nuestro calendario real. Sin promesas vagas.' },
        ].map((s) => (
          <li class="rounded-2xl bg-white ring-1 ring-brand-100 shadow-sm p-7">
            <div class="font-display text-3xl font-extrabold text-wood-500">{s.n}</div>
            <h3 class="mt-2 font-display text-lg font-bold text-brand-900">{s.t}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{s.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* FINANCIAMIENTO — anunciado en el sitio principal (/financing/) */}
  <section class="bg-gradient-to-r from-wood-600 to-wood-800 text-white">
    <div class="mx-auto max-w-4xl px-5 py-12 lg:py-14 text-center">
      <div class="text-[0.7rem] uppercase tracking-[0.2em] font-bold text-white/85">Financiamiento</div>
      <h2 class="mt-2 font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight text-white">Financiamiento promocional al 0% disponible</h2>
      <p class="mt-3 text-white/90 max-w-2xl mx-auto">Para clientes que califiquen. Revisamos las opciones durante su estimación gratuita en casa.</p>
      <a href="#form" class="mt-6 inline-flex rounded-full bg-white text-wood-800 hover:bg-wood-50 px-7 py-3.5 font-bold text-sm">Cuéntenos sobre su proyecto</a>
      <p class="mt-4 text-xs text-white/70">Sujeto a aprobación de crédito por nuestros socios de financiamiento. Los términos varían.</p>
    </div>
  </section>

  {/* RESPUESTAS RÁPIDAS */}
  <section class="bg-white py-14 lg:py-20">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="text-center font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight text-brand-900">Respuestas rápidas.</h2>
      <ul class="mt-10 divide-y divide-brand-100 ring-1 ring-brand-100 rounded-2xl bg-brand-50/60 overflow-hidden list-none p-0">
        {faqs.map((f) => (
          <li>
            <details class="group">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none">
                <span class="font-display font-semibold text-base text-brand-900">{f.q}</span>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-wood-500 transition-transform group-open:rotate-180 flex-none"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p class="px-6 pb-5 -mt-1 text-sm text-slate-600 leading-relaxed">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* CTA FINAL */}
  <section class="bg-brand-950 text-white">
    <div class="mx-auto max-w-3xl px-5 py-16 lg:py-24 text-center">
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight text-white">Hablemos de sus pisos.</h2>
      <a href="#form" class="mt-8 inline-flex rounded-full bg-wood-500 hover:bg-wood-600 px-8 py-4 text-base font-bold text-white">Cuéntenos sobre su proyecto</a>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[11px] uppercase tracking-[0.2em] text-white/60 font-semibold">
        <span>Licencia y Seguro</span><span class="opacity-30">·</span>
        <span>Empresa Familiar</span><span class="opacity-30">·</span>
        <span>{business.yearsInBusiness}+ Años</span>
      </div>
    </div>
  </section>

  <!-- LeadConnector form auto-resize (preloaded in <head>) -->
  <script src="https://link.msgsndr.com/js/form_embed.js" defer></script>

  {/* Contador semanal: cuenta hasta el próximo lunes 00:00 en la zona horaria del cliente,
      así todos ven el mismo reloj y se reinicia cada domingo a medianoche. */}
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-countdown]');
      if (!root) return;
      var tz = root.getAttribute('data-tz');
      var cells = {};
      ['d', 'h', 'm', 's'].forEach(function (k) { cells[k] = root.querySelector('[data-cd="' + k + '"]'); });
      var fmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short', hour: 'numeric', minute: 'numeric', second: 'numeric', hourCycle: 'h23' });
      var DOW = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7 };
      function pad(n) { return n < 10 ? '0' + n : String(n); }
      function tick() {
        var p = {};
        fmt.formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
        var intoDay = (+p.hour) * 3600 + (+p.minute) * 60 + (+p.second);
        var left = (8 - DOW[p.weekday]) * 86400 - intoDay;
        cells.d.textContent = pad(Math.floor(left / 86400));
        cells.h.textContent = pad(Math.floor((left % 86400) / 3600));
        cells.m.textContent = pad(Math.floor((left % 3600) / 60));
        cells.s.textContent = pad(left % 60);
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>
</LandingLayout>

<style>
  .fe-strip-track { animation: fe-marquee 40s linear infinite; width: max-content; }
  @keyframes fe-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .fe-strip-track { animation: none; } }

  .cd-seg {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(214, 180, 126, 0.4);
    border-radius: 12px;
    padding: 0.7rem 0.4rem;
    min-width: 66px;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }
  .cd-seg > span { font-size: 2rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .cd-seg small { margin-top: 0.35rem; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.7; }
  @media (min-width: 720px) {
    .cd-seg { min-width: 88px; padding: 1rem 0.5rem; }
    .cd-seg > span { font-size: 2.75rem; }
  }
</style>
