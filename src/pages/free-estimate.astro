---
/**
 * /free-estimate — paid-traffic funnel landing page (FB / Meta).
 * Layout follows the TFPros /book funnel (house funnel template):
 * promo strip -> headline + FORM (in view on land) -> weekly-openings timer ->
 * real reviews -> facts -> what happens next -> financing -> quick answers -> final CTA.
 * Only claims that appear on the main site (20+ yrs family-owned, rating from
 * business.ts, lifetime workmanship guarantee, licensed & insured, 0% promo
 * financing per /financing/). No discounts — the main site runs none.
 * Spanish mirror: /es/free-estimate/ — keep the two in sync.
 */
import LandingLayout from '~/layouts/LandingLayout.astro';
import { business } from '~/data/business';
import { testimonials } from '~/data/testimonials';

const reviews = testimonials.filter((t) => !/placeholder/i.test(t.text)).slice(0, 6);
const TZ = 'America/Los_Angeles';
const { averageRating, reviewCount } = business.ratings;

const strip = [
  `Family-owned for ${business.yearsInBusiness}+ years`,
  `${averageRating}★ on Google`,
  'Free in-home estimates · samples on-site',
  'Lifetime workmanship guarantee',
  'Licensed & insured in California',
  'Serving the Inland Empire',
];

const faqs = [
  { q: 'Is the estimate free?', a: 'Yes. Every estimate is free and no-pressure, with samples on-site. We measure, take subfloor moisture readings, walk through species and finish options, and give you a written, itemized quote.' },
  { q: 'What areas do you serve?', a: 'The entire Inland Empire — San Bernardino, Fontana, Rancho Cucamonga, Ontario, Riverside, Corona, Rialto, Redlands, Highland and Loma Linda — plus larger projects in Orange County and Palm Springs by appointment.' },
  { q: 'Are you licensed and insured?', a: 'Yes. Fully licensed in California and insured with both general liability and workers\' compensation.' },
  { q: 'What kind of warranty do you offer?', a: 'A lifetime workmanship guarantee on every install — if our installation ever fails, we fix it. Material warranties vary by product.' },
];
---
<LandingLayout
  title="Free In-Home Flooring Estimate | Monteros Hardwood Flooring"
  description="Tell us about your hardwood flooring project. Free, no-pressure in-home estimate across the Inland Empire. Family-owned, licensed and insured."
  pathname="/free-estimate/"
>
  {/* PROMO STRIP — scrolling, true facts only */}
  <div class="fe-strip bg-wood-600 text-white overflow-hidden" aria-label="Why Monteros">
    <div class="fe-strip-track flex whitespace-nowrap py-2 text-[0.8rem] font-semibold tracking-wide">
      {Array.from({ length: 2 }).map(() => (
        <div class="flex shrink-0 items-center">
          {strip.map((msg) => (
            <span class="flex items-center px-5">
              <span>{msg}</span>
              <span class="ml-10 text-white/50" aria-hidden="true">·</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  {/* HERO — headline + subhead, then the form (in view on land, mobile + desktop) */}
  <section class="bg-brand-900 text-white">
    <div class="mx-auto w-full max-w-6xl px-5 pt-4 pb-12 lg:pt-14 lg:pb-20">
      <div class="grid lg:grid-cols-[1fr_480px] gap-5 lg:gap-14 items-start">
        <div class="lg:pt-6">
          <h1 class="font-display font-extrabold tracking-tight leading-[1.1] text-[1.6rem] sm:text-4xl lg:text-5xl text-white">
            We'd love to talk to you about <span class="text-wood-300">your project.</span>
          </h1>
          <p class="mt-2 lg:mt-5 text-[0.95rem] sm:text-lg text-white/80 leading-snug lg:leading-relaxed max-w-xl">
            Submit your info and someone will reach out to you regarding your project and your vision.
          </p>
          <ul class="hidden lg:grid mt-7 gap-2.5 list-none p-0">
            {[
              'Free, no-pressure in-home estimate',
              'Samples brought on-site',
              'Written, itemized quote',
              'Lifetime workmanship guarantee',
            ].map((v) => (
              <li class="flex items-center gap-2.5 text-base text-white/90">
                <svg class="w-5 h-5 flex-none text-wood-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                <span>{v}</span>
              </li>
            ))}
          </ul>
        </div>

        <div id="form" class="scroll-mt-4">
          <div class="rounded-2xl bg-white ring-1 ring-wood-400/40 shadow-xl overflow-hidden">
            <div class="bg-gradient-to-r from-wood-500 to-wood-700 px-5 py-2.5">
              <div class="text-[0.65rem] uppercase tracking-[0.2em] font-bold text-white/85">Free · No obligation</div>
              <div class="font-display text-lg font-bold text-white leading-tight">Tell us about your project</div>
            </div>
            {/* Holds the survey's settled height (469px) so nothing below moves while
                form_embed.js briefly takes the iframe out of flow during load. */}
            <div style="min-height:469px">
            <iframe
              src="https://api.leadconnectorhq.com/widget/survey/KorNp0UbZXR5C1EggcJH"
              style="border:none;width:100%;height:469px;display:block;background:transparent;"
              scrolling="no"
              id="KorNp0UbZXR5C1EggcJH"
              title="Free estimate request"
              loading="eager"
              fetchpriority="high"
              referrerpolicy="strict-origin-when-cross-origin"
            ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* WEEKLY OPENINGS — resets every Sunday at midnight, Inland Empire (Pacific) time */}
  <section class="bg-gradient-to-r from-brand-950 via-brand-800 to-brand-950 text-white border-y border-wood-400/30">
    <div class="mx-auto max-w-6xl px-5 py-10 lg:py-14 flex flex-col lg:flex-row items-center justify-between gap-7">
      <div class="text-center lg:text-left">
        <span class="inline-flex items-center gap-2 rounded-full bg-white/10 ring-1 ring-white/20 px-3 py-1 text-[0.65rem] uppercase tracking-[0.2em] font-bold">
          <span class="h-1.5 w-1.5 rounded-full bg-wood-300 animate-pulse"></span>
          Limited openings
        </span>
        <h2 class="mt-3 font-display text-3xl sm:text-4xl font-extrabold leading-tight text-white">This week's estimate openings</h2>
        <p class="mt-2 text-white/75">The schedule for this week closes when the timer hits zero.</p>
      </div>
      <div class="flex gap-2.5 sm:gap-3" data-countdown data-tz={TZ} role="timer" aria-label="Time left to book this week">
        {[['d', 'Days'], ['h', 'Hrs'], ['m', 'Min'], ['s', 'Sec']].map(([k, label]) => (
          <div class="cd-seg">
            <span data-cd={k}>--</span>
            <small>{label}</small>
          </div>
        ))}
      </div>
    </div>
    <div class="pb-10 text-center">
      <a href="#form" class="inline-flex items-center gap-2 rounded-full bg-wood-600 hover:bg-wood-700 px-7 py-3.5 font-bold text-sm text-white">
        Grab a spot this week
        <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </section>

  {/* SOCIAL PROOF — real Google reviews (verbatim, src/data/testimonials.ts) */}
  <section class="bg-white py-14 lg:py-20">
    <div class="mx-auto max-w-6xl px-5">
      <div class="text-center max-w-2xl mx-auto">
        <div class="text-amber-400 tracking-[0.2em] text-lg" aria-hidden="true">★★★★★</div>
        <h2 class="mt-2 font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight text-brand-900">What Inland Empire homeowners say.</h2>
        <p class="mt-2 text-sm text-slate-500">Real Google reviews · {averageRating}★ across {reviewCount} reviews</p>
      </div>
      <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 list-none p-0">
        {reviews.map((t) => (
          <li class="rounded-2xl bg-brand-50 ring-1 ring-brand-100 p-6">
            <div class="flex items-center gap-3">
              <span class="grid h-10 w-10 place-items-center rounded-full bg-brand-700 text-white font-bold text-sm" aria-hidden="true">{t.author.charAt(0)}</span>
              <div class="leading-tight">
                <div class="font-semibold text-sm text-brand-900">{t.author}</div>
                <div class="text-[11px] text-slate-600">{t.city}{t.service ? ` · ${t.service}` : ''}</div>
              </div>
              <div class="ml-auto text-amber-400 tracking-[2px] text-sm" role="img" aria-label={`${t.rating} out of 5 stars`}>{'★'.repeat(t.rating)}</div>
            </div>
            <p class="mt-4 text-sm text-slate-700 leading-relaxed">"{t.text}"</p>
          </li>
        ))}
      </ul>
      <div class="mt-8 text-center">
        <a href="#form" class="inline-flex items-center gap-2 rounded-full bg-brand-700 hover:bg-brand-800 px-6 py-3 font-semibold text-white text-sm">Tell us about your project</a>
      </div>
    </div>
  </section>

  {/* FACTS BAND — only what the main site states */}
  <section class="bg-brand-900 text-white py-12 lg:py-16">
    <ul class="mx-auto max-w-6xl px-5 grid grid-cols-2 lg:grid-cols-4 gap-y-8 gap-x-6 text-center list-none p-0">
      {[
        { v: `${business.yearsInBusiness}+`, label: 'Years family-owned' },
        { v: `${averageRating}★`, label: 'On Google' },
        { v: 'Lifetime', label: 'Workmanship guarantee' },
        { v: 'Licensed', label: '& insured in California' },
      ].map((s) => (
        <li>
          <div class="font-display text-4xl sm:text-5xl font-extrabold text-wood-300 leading-none">{s.v}</div>
          <div class="mt-3 text-[11px] uppercase tracking-[0.22em] text-brand-200 font-semibold">{s.label}</div>
        </li>
      ))}
    </ul>
  </section>

  {/* WHAT HAPPENS NEXT */}
  <section class="bg-brand-50 py-14 lg:py-20">
    <div class="mx-auto max-w-5xl px-5">
      <h2 class="text-center font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight text-brand-900">What happens next.</h2>
      <ol class="mt-10 grid gap-5 md:grid-cols-3 list-none p-0">
        {[
          { n: '01', t: 'We reach out', b: 'Someone from our team contacts you to talk through your project and your vision.' },
          { n: '02', t: 'Free in-home estimate', b: 'We bring samples, measure, take subfloor moisture readings and walk through species and finish options. No pressure.' },
          { n: '03', t: 'Written quote', b: 'An itemized quote in writing, with our actual schedule. No vague promises.' },
        ].map((s) => (
          <li class="rounded-2xl bg-white ring-1 ring-brand-100 shadow-sm p-7">
            <div class="font-display text-3xl font-extrabold text-wood-500">{s.n}</div>
            <h3 class="mt-2 font-display text-lg font-bold text-brand-900">{s.t}</h3>
            <p class="mt-2 text-sm text-slate-600 leading-relaxed">{s.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* FINANCING — advertised on the main site (/financing/) */}
  <section class="bg-gradient-to-r from-wood-600 to-wood-800 text-white">
    <div class="mx-auto max-w-4xl px-5 py-12 lg:py-14 text-center">
      <div class="text-[0.7rem] uppercase tracking-[0.2em] font-bold text-white/85">Financing</div>
      <h2 class="mt-2 font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight text-white">0% promotional financing available</h2>
      <p class="mt-3 text-white/90 max-w-2xl mx-auto">For qualified customers. We walk through the options during your free in-home estimate.</p>
      <a href="#form" class="mt-6 inline-flex rounded-full bg-white text-wood-800 hover:bg-wood-50 px-7 py-3.5 font-bold text-sm">Tell us about your project</a>
      <p class="mt-4 text-xs text-white/70">Subject to credit approval by our financing partners. Terms vary.</p>
    </div>
  </section>

  {/* QUICK ANSWERS */}
  <section class="bg-white py-14 lg:py-20">
    <div class="mx-auto max-w-3xl px-5">
      <h2 class="text-center font-display text-2xl sm:text-3xl lg:text-4xl font-extrabold leading-tight text-brand-900">Quick answers.</h2>
      <ul class="mt-10 divide-y divide-brand-100 ring-1 ring-brand-100 rounded-2xl bg-brand-50/60 overflow-hidden list-none p-0">
        {faqs.map((f) => (
          <li>
            <details class="group">
              <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none">
                <span class="font-display font-semibold text-base text-brand-900">{f.q}</span>
                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-wood-500 transition-transform group-open:rotate-180 flex-none"><polyline points="6 9 12 15 18 9"/></svg>
              </summary>
              <p class="px-6 pb-5 -mt-1 text-sm text-slate-600 leading-relaxed">{f.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* FINAL CTA */}
  <section class="bg-brand-950 text-white">
    <div class="mx-auto max-w-3xl px-5 py-16 lg:py-24 text-center">
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold leading-tight text-white">Let's talk about your floors.</h2>
      <a href="#form" class="mt-8 inline-flex rounded-full bg-wood-600 hover:bg-wood-700 px-8 py-4 text-base font-bold text-white">Tell us about your project</a>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[11px] uppercase tracking-[0.2em] text-white/60 font-semibold">
        <span>Licensed &amp; Insured</span><span class="opacity-30">·</span>
        <span>Family-Owned</span><span class="opacity-30">·</span>
        <span>{business.yearsInBusiness}+ Years</span>
      </div>
    </div>
  </section>

  <!-- LeadConnector form auto-resize (preloaded in <head>) -->
  <script src="https://link.msgsndr.com/js/form_embed.js" defer></script>

  {/* Weekly openings countdown: counts to next Monday 00:00 in the client's time zone,
      so everyone sees the same clock and it resets every Sunday at midnight. */}
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-countdown]');
      if (!root) return;
      var tz = root.getAttribute('data-tz');
      var cells = {};
      ['d', 'h', 'm', 's'].forEach(function (k) { cells[k] = root.querySelector('[data-cd="' + k + '"]'); });
      var fmt = new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'short', hour: 'numeric', minute: 'numeric', second: 'numeric', hourCycle: 'h23' });
      var DOW = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7 };
      function pad(n) { return n < 10 ? '0' + n : String(n); }
      function tick() {
        var p = {};
        fmt.formatToParts(new Date()).forEach(function (x) { p[x.type] = x.value; });
        var intoDay = (+p.hour) * 3600 + (+p.minute) * 60 + (+p.second);
        var left = (8 - DOW[p.weekday]) * 86400 - intoDay;
        cells.d.textContent = pad(Math.floor(left / 86400));
        cells.h.textContent = pad(Math.floor((left % 86400) / 3600));
        cells.m.textContent = pad(Math.floor((left % 3600) / 60));
        cells.s.textContent = pad(left % 60);
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>
</LandingLayout>

<style>
  .fe-strip-track { animation: fe-marquee 40s linear infinite; width: max-content; }
  @keyframes fe-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .fe-strip-track { animation: none; } }

  .cd-seg {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(214, 180, 126, 0.4);
    border-radius: 12px;
    padding: 0.7rem 0.4rem;
    min-width: 66px;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
  }
  .cd-seg > span { font-size: 2rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .cd-seg small { margin-top: 0.35rem; font-size: 0.6rem; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.7; }
  @media (min-width: 720px) {
    .cd-seg { min-width: 88px; padding: 1rem 0.5rem; }
    .cd-seg > span { font-size: 2.75rem; }
  }
</style>
